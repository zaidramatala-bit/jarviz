{
  "name": "@vrbo/jarviz-graph",
  "version": "0.1.7",
  "description": "Utility for graphing JAR coupling data provided via jarviz",
  "main": "lib/index.js",
  "bin": "./bin/index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack",
    "build:example": "npm run build && NODE_ENV=production node bin/index --input=lib/mock --output=build",
    "clean": "rimraf build",
    "start": "npm run start:dev",
    "start:dev": "NODE_ENV=development webpack-dev-server",
    "prepublish": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ExpediaGroup/jarviz.git",
    "directory": "jarviz-graph"
  },
  "keywords": [
    "jarviz",
    "graphing"
  ],
  "author": {
    "name": "Expedia Group",
    "email": "oss@expediagroup.com"
  },
  "contributors": [
    "neenhouse",
    "lasanthak"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "dependencies": {
    "@babel/core": "^7.5.5",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/plugin-proposal-class-properties": "^7.5.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.5.5",
    "@babel/plugin-transform-destructuring": "^7.5.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "alphabetize-object-keys": "^3.0.0",
    "babel-loader": "^9.1.3",
    "chalk": "^2.4.2",
    "commander": "^3.0.0",
    "copy-dir": "^1.2.0",
    "css-loader": "^6.8.1",
    "d3-scale": "^3.0.0",
    "d3-scale-chromatic": "^1.3.3",
    "eslint": "^8.55.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-webpack-plugin": "^4.0.1",
    "glob": "^7.1.4",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.5.4",
    "js-beautify": "^1.10.0",
    "mkdirp": "^0.5.1",
    "prettier": "^1.18.2",
    "pretty-quick": "^1.11.1",
    "react": "^16.9.0",
    "react-dom": "^16.9.0",
    "react-force-graph": "~1.46.0",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
